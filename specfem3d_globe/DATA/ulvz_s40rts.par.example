# Optional CMB cylindrical-cap ULVZ overlay parameters.
# MODEL in Par_file determines the actual background; BACKGROUND_MODEL is a
# required audit field and must match it exactly (PREM or S40RTS).
# Copy to DATA/ulvz_s40rts.par for an actual run; the real parameter file is not tracked here.

BACKGROUND_MODEL = S40RTS
ENABLED = .false.

# Center location in geographic degrees. Longitude is normalized to [-180,180).
CENTER_LATITUDE_DEGREES = 0.0
CENTER_LONGITUDE_DEGREES = 0.0

# Geometry in kilometers above the CMB and along the CMB arc.
THICKNESS_KM = 20.0
LATERAL_RADIUS_KM = 100.0
LATERAL_TAPER_KM = 20.0
TOP_TAPER_KM = 5.0

# Relative perturbations. For S40RTS they are applied on top of local native
# tomography; for PREM they scale the complete PREM material components.
DVS = -0.20
DVP = -0.10
DRHO = 0.10
